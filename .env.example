# Copy to .env and fill in. `set -a; source .env; set +a` before running the tools.

# --- Gemini (the LLM judge) ---
# Preferred: a plain API key.
GEMINI_API_KEY=

# Or pull the key from gcloud Secret Manager instead (leave GEMINI_API_KEY blank):
# GEMINI_SECRET_NAME=your-secret-name
# GEMINI_SECRET_PROJECT=your-gcp-project

# Optional overrides:
# VIDEO_MODEL=gemini-2.5-flash
# VIDEO_REVIEW_PROMPT=/path/to/custom-review-prompt.txt

# --- Where files live ---
# Raw archive (loom-pull.sh saves here; keep your masters here):
VIDEO_RAWS=./raws
# Output root: work/<slug>/ and clips/<slug>/ are written under this:
VIDEO_WORK=.
