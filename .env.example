# Copy to .env and fill in. `set -a; source .env; set +a` before running the tools.

# --- Gemini (the LLM judge) ---
# Preferred: a plain API key.
GEMINI_API_KEY=

# Or pull the key from gcloud Secret Manager instead (leave GEMINI_API_KEY blank):
# GEMINI_SECRET_NAME=your-secret-name
# GEMINI_SECRET_PROJECT=your-gcp-project

# Optional overrides:
# VIDEO_MODEL=gemini-2.5-flash
# VIDEO_REVIEW_PROMPT=/path/to/custom-review-prompt.txt

# --- Transcription (transcribe.sh) ---
# Path to a whisper/whisper.cpp binary. Leave unset to auto-detect
# whisper-cli/main/whisper on $PATH; transcribe.sh is a no-op (exit 0) if none is found.
# VIDEO_WHISPER_BIN=/path/to/whisper-cli
# Model name/path passed to the binary. Default: base
# VIDEO_WHISPER_MODEL=base

# --- Captions (caption.sh) ---
# Burn styled captions into cut clips (writes <name>.captioned.mp4 alongside the
# original). Default: off (only transcript.srt is generated).
# VIDEO_CAPTION_BURN=1
# Optional ffmpeg subtitles force_style string, e.g. "FontSize=24,PrimaryColour=&H00FFFF&"
# VIDEO_CAPTION_STYLE=

# --- Where files live ---
# Raw archive (loom-pull.sh saves here; keep your masters here):
VIDEO_RAWS=./raws
# Output root: work/<slug>/ and clips/<slug>/ are written under this:
VIDEO_WORK=.
